# BookFinder Bot

BOT_TOKEN=
PYROGRAM_API_ID=
PYROGRAM_API_HASH=
PYROGRAM_SESSION_NAME=book_finder_session

DUMP_CHANNEL_ID=

# Virgülle ayrılmış Telegram kanal/grup kullanıcı adları veya ID'leri
# Örnek: @turkce_kitaplar,-1001234567890,@pdf_arsiv
TARGET_CHATS=

# Rate limit: kullanıcı başına dakikada max arama sayısı
RATE_LIMIT_PER_MINUTE=5

# Arama başına maksimum sonuç
MAX_RESULTS=5

# Cache süre aşımı (saat) — bu süre sonra eski sonuçlar silinir
CACHE_TTL_HOURS=12

# Kanal başına arama timeout (saniye) — yanıt gelmezse atlanır
SEARCH_TIMEOUT_SECONDS=15

# Kullanıcı oturumu TTL (dakika) — bu süre sonra session RAM'den temizlenir
SESSION_TTL_MINUTES=30
